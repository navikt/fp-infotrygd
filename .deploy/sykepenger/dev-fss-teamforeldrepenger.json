{
  "appName": "fp-infotrygd-sykepenger",
  "minReplicas": "1",
  "maxReplicas": "2",
  "limits": {
    "mem": "800Mi"
  },
  "requests": {
    "cpu": "50m",
    "mem": "640Mi"
  },
  "vault": {
    "mountPath": "/var/run/secrets/nais.io",
    "db": {
      "secretsPath": "oracle/data/dev/creds/sp_infotrygd_q-user",
      "configPath": "oracle/data/dev/config/infotrygd_spq"
    }
  },
  "env": {
    "DEFAULTDS_SCHEMA": "INFOTRYGD_SPQ"
  },
  "AZURE_IAC_RULES": [
    {
      "app": "fpabakus",
      "namespace": "teamforeldrepenger",
      "cluster": "dev-fss"
    },
    {
      "app": "fprisk",
      "namespace": "teamforeldrepenger",
      "cluster": "dev-fss"
    },
    {
      "app": "fpsak",
      "namespace": "teamforeldrepenger",
      "cluster": "dev-fss"
    },
    {
      "app": "k9-abakus",
      "namespace": "k9saksbehandling",
      "cluster": "dev-fss"
    }
  ]
}
