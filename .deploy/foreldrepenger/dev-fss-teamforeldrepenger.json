{
  "appName": "fp-infotrygd-foreldrepenger",
  "minReplicas": "1",
  "maxReplicas": "2",
  "limits": {
    "mem": "800Mi"
  },
  "requests": {
    "cpu": "25m",
    "mem": "640Mi"
  },
  "vault": {
    "mountPath": "/var/run/secrets/nais.io",
    "db": {
      "secretsPath": "oracle/data/dev/creds/fp_infotrygd_q1-user",
      "configPath": "oracle/data/dev/config/infotrygd_fpq"
    }
  },
  "env": {
    "DEFAULTDS_SCHEMA": "INFOTRYGD_FPQ"
  },
  "AZURE_IAC_RULES": [
    {
      "app": "fpsak",
      "namespace": "teamforeldrepenger",
      "cluster": "dev-fss"
    }
  ]
}
